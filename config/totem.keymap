/*
 * TOTEM (ZMK) - keymap portado do Cantor (4 camadas)
 *
 * Ordem das teclas (38) = ordem do arquivo, linha a linha:
 *   linha 1: 5 esq + 5 dir            (posicoes  0-9)
 *   linha 2: 5 esq + 5 dir            (posicoes 10-19)
 *   linha 3: 6 esq + 6 dir            (posicoes 20-31)  <- tecla extra no canto externo
 *   polegares: 3 esq + 3 dir          (posicoes 32-37)
 *
 * Camadas (iguais as do Cantor):
 *   0 BASE  - QWERTY
 *   1 NUM   - segura o espaco da ESQUERDA (numeros + numpad na mao direita)
 *   2 NAV   - segura o espaco da DIREITA  (setas, Home/End, PgUp/PgDn, simbolos)
 *   3 MOUSE - segura os dois espacos juntos (Layer 1 + 2), igual ao LT3 do Cantor
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE  0
#define NUM   1
#define NAV   2
#define MOUSE 3

/* Layer-tap do espaco (equivalente ao LT(n, KC_SPACE)) */
&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
    require-prior-idle-ms = <120>;
};

/*
 * COMBOS - o Totem tem menos teclas que o Cantor, entao as teclas
 * da coluna externa (Tab, LCtrl, Esc) viraram combos na camada BASE.
 * Pode trocar as posicoes a vontade.
 */
/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <40>;
            key-positions = <0 1>;      /* Q + W */
            bindings = <&kp ESC>;
            layers = <BASE>;
        };
        combo_tab {
            timeout-ms = <40>;
            key-positions = <0 10>;     /* Q + A */
            bindings = <&kp TAB>;
            layers = <BASE>;
        };
        combo_lctrl {
            timeout-ms = <40>;
            key-positions = <21 22>;    /* Z + X */
            bindings = <&kp LCTRL>;
            layers = <BASE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* ---------------- CAMADA 0 : BASE ---------------- */
        base_layer {
            display-name = "BASE";
            bindings = <
                &kp Q     &kp W   &kp E   &kp R   &kp T            &kp Y   &kp U   &kp I      &kp O     &kp P
                &kp A     &kp S   &kp D   &kp F   &kp G            &kp H   &kp J   &kp K      &kp L     &kp SEMI
    &kp LSHFT   &kp Z     &kp X   &kp C   &kp V   &kp B            &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp LALT
                          &kp LGUI  &lt NUM SPACE  &kp BSPC        &kp RET &lt NAV SPACE  &kp RALT
            >;
        };

        /* ---------------- CAMADA 1 : NUM ---------------- */
        /* esquerda: 1-5 (o 6 fica no numpad da direita), ~`, LAlt, LShift */
        num_layer {
            display-name = "NUM";
            bindings = <
                &kp N1    &kp N2  &kp N3  &kp N4     &kp N5        &kp N7  &kp N8  &kp N9   &kp N0    &trans
                &trans    &trans  &trans  &kp GRAVE  &kp LALT      &kp N4  &kp N5  &kp N6   &trans    &trans
    &trans      &trans    &trans  &trans  &trans     &kp LSHFT     &kp N1  &kp N2  &kp N3   &trans    &trans    &trans
                          &trans  &trans  &trans                   &trans  &mo MOUSE  &kp N0
            >;
        };

        /* ---------------- CAMADA 2 : NAV ---------------- */
        nav_layer {
            display-name = "NAV";
            bindings = <
                &kp F11   &kp ESC  &trans      &trans       &trans        &kp MINUS  &kp EQUAL  &kp LEFT  &kp RIGHT  &trans
                &kp CAPS  &kp RBKT &kp BSLH    &kp BSLH     &trans        &kp PG_UP  &kp LBKT   &trans    &kp HOME    &kp SQT
    &trans      &trans    &trans   &trans      &trans       &trans        &kp PG_DN  &kp LALT   &kp DEL   &kp END     &trans    &trans
                          &trans   &mo MOUSE   &trans                     &trans     &trans     &trans
            >;
        };

        /* ---------------- CAMADA 3 : MOUSE / EXTRAS ---------------- */
        /* M0-M3 eram macros do Vial: deixei como &none (veja nota no fim do arquivo) */
        mouse_layer {
            display-name = "MOUSE";
            bindings = <
                &bt BT_SEL 0  &kp PSCRN &kp UP    &none      &none     &msc SCRL_UP    &mkp MB1         &mmv MOVE_UP    &mkp MB2          &out OUT_TOG
                &bt BT_SEL 1  &kp LEFT  &kp DOWN  &kp RIGHT  &none     &msc SCRL_DOWN  &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_RIGHT   &sys_reset
    &bt BT_SEL 4  &bt BT_SEL 2  &bt BT_SEL 3  &kp F11   &kp F12    &none     &trans          &msc SCRL_LEFT   &trans          &msc SCRL_RIGHT   &bt BT_CLR  &bootloader
                          &trans    &trans    &trans                   &trans          &trans           &trans
            >;
        };
    };
};

/*
 * Notas:
 * - M0..M3 (macros): se quiser recriar, defina macros ZMK (zmk,behavior-macro)
 *   e troque os &none da camada MOUSE (posicoes M0/M1/M2/M3).
 * - Mouse (&mmv, &msc, &mkp) exige CONFIG_ZMK_POINTING=y no totem.conf.
 *
 * Teclas Bluetooth/sistema (camada 3, nas posicoes livres):
 *   esquerda: BT_SEL 0 e 1 na coluna do Q/A, BT_SEL 4 (canto), 2 e 3 na linha de baixo
 *   direita : OUT_TOG (alterna USB/BLE) e sys_reset na coluna do P/;
 *             BT_CLR e bootloader nos dois cantos de baixo (longe de teclas de uso comum)
 *   BT_CLR apaga o pareamento do perfil ativo; bootloader coloca a metade em modo de gravacao.
 *   Cada metade e independente: use as teclas na metade que quiser reparear/gravar.
 */
